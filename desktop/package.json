{
  "name": "courtside-desktop",
  "productName": "Courtside",
  "version": "0.2.5",
  "description": "Courtside fantasy basketball analytics for macOS and Windows",
  "main": "main.js",
  "author": "Courtside",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "copy:web": "node scripts/copy-web.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "start": "npm run build:web && npm run copy:web && electron .",
    "dev": "electron . --dev",
    "dist:win": "npm run build:web && npm run copy:web && npm run build:engine && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build:web && npm run copy:web && npm run build:engine && electron-builder --mac zip --publish never",
    "dist:dir": "npm run build:web && npm run copy:web && npm run build:engine && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.courtside.desktop",
    "productName": "Courtside",
    "publish": [
      {
        "provider": "github",
        "owner": "KrishModi6",
        "repo": "fantasybasketball",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "web-dist/**/*",
      "package.json",
      "ai-config.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.sports",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "../server/dist/courtside-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
